{%- liquid
  assign status_labels = 'development:In development,testing:In cabin testing,coming-soon:Coming soon,waitlist:Waitlist open' | split: ','
-%}

{% style %}
  #shopify-section-{{ section.id }} .backlog {
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  .backlog__head {
    max-width: 40rem;
    margin-bottom: var(--cabin-space-6);
  }

  .backlog__head > * { margin: 0; }
  .backlog__head .cabin-label { margin-bottom: var(--cabin-space-3); }
  .backlog__head .cabin-body { margin-top: var(--cabin-space-4); }

  .backlog__list {
    border-top: 1px solid var(--cabin-border);
  }

  .release {
    border-bottom: 1px solid var(--cabin-border);
  }

  .release__summary {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: var(--cabin-space-4);
    padding: var(--cabin-space-5) 0;
    list-style: none;
    cursor: pointer;
    color: var(--cabin-display);
  }

  .release__summary::-webkit-details-marker { display: none; }

  .release__summary:focus-visible {
    outline: 2px solid var(--cabin-brass);
    outline-offset: 4px;
  }

  .release__index {
    font-family: var(--cabin-font-ui);
    font-size: var(--cabin-fs-xs);
    letter-spacing: var(--cabin-track-label);
    color: var(--cabin-text-muted);
    min-width: 2ch;
  }

  .release__title {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .release__format {
    font-family: var(--cabin-font-serif);
    font-size: var(--cabin-fs-sm);
    letter-spacing: var(--cabin-track-serif);
    color: var(--cabin-text-muted);
  }

  .release__eta {
    font-family: var(--cabin-font-ui);
    font-size: var(--cabin-fs-xs);
    letter-spacing: var(--cabin-track-label);
    text-transform: uppercase;
    color: var(--cabin-text-muted);
    white-space: nowrap;
  }

  .release__chevron {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--cabin-border);
    border-radius: 50%;
    transition: transform var(--cabin-dur-base) var(--cabin-ease-out), border-color var(--cabin-dur-fast) var(--cabin-ease-out);
  }

  .release__chevron svg { width: 10px; height: 10px; }
  .release[open] .release__chevron { transform: rotate(180deg); border-color: var(--cabin-brass); }
  .release__summary:hover .release__chevron { border-color: var(--cabin-brass); }

  .release__body {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--cabin-space-6);
    padding: 0 0 var(--cabin-space-6) calc(2ch + var(--cabin-space-4));
    animation: release-in var(--cabin-dur-slow) var(--cabin-ease-out);
  }

  @media (min-width: 900px) {
    .release__body { grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 1fr); }
  }

  .release__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--cabin-radius-md);
    border: 1px solid var(--cabin-border);
    margin-bottom: var(--cabin-space-4);
  }

  .release__media img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .release__copy .cabin-body { margin: 0; }
  .release__copy .cabin-body + .cabin-body { margin-top: var(--cabin-space-3); }

  .release__pill--development { color: var(--cabin-text-muted); }
  .release__pill--testing { border-color: var(--cabin-brass-deep); color: var(--cabin-brass-light); }
  .release__pill--coming-soon,
  .release__pill--waitlist { border-color: var(--cabin-brass); color: var(--cabin-brass); }

  @keyframes release-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 599px) {
    .release__summary { grid-template-columns: 1fr auto; }
    .release__index, .release__eta { display: none; }
    .release__body { padding-left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .release__body { animation: none; }
    .release__chevron { transition: none; }
  }
{% endstyle %}

<div class="backlog cabin-theme">
  <div class="cabin-container">
    <header class="backlog__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cabin-label cabin-label--brass">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="cabin-display cabin-display--lg">{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}
        <div class="cabin-body">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    {%- render 'cabin-notify-form', key: 'styles', styles_only: true -%}

    <div class="backlog__list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign status_label = block.settings.status
          for pair in status_labels
            assign parts = pair | split: ':'
            if parts[0] == block.settings.status
              assign status_label = parts[1]
            endif
          endfor
          assign release_key = block.settings.key | default: block.settings.title | handleize
        -%}
        <details class="release" {{ block.shopify_attributes }} {% if block.settings.open_by_default %}open{% endif %}>
          <summary class="release__summary" aria-label="{{ block.settings.title | escape }}, {{ status_label | escape }}">
            <span class="release__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="release__title">
              <span class="cabin-display cabin-display--sm">{{ block.settings.title }}</span>
              {%- if block.settings.format != blank -%}
                <span class="release__format">{{ block.settings.format }}</span>
              {%- endif -%}
            </span>
            {%- if block.settings.eta != blank -%}
              <span class="release__eta">{{ block.settings.eta }}</span>
            {%- endif -%}
            <span class="cabin-pill release__pill--{{ block.settings.status }}">{{ status_label }}</span>
            <span class="release__chevron" aria-hidden="true">
              <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M1 3l4 4 4-4"/></svg>
            </span>
          </summary>

          <div class="release__body">
            <div class="release__copy">
              {%- if block.settings.image != blank -%}
                <div class="release__media">
                  {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 900px) 50vw, 100vw', loading: 'lazy' }}
                </div>
              {%- endif -%}
              {{ block.settings.description }}
            </div>
            <div>
              {%- if block.settings.show_notify -%}
                {%- render 'cabin-notify-form',
                  key: release_key,
                  title: block.settings.title,
                  heading: section.settings.notify_heading,
                  body: section.settings.notify_body,
                  success: section.settings.notify_success,
                  skip_styles: true
                -%}
              {%- endif -%}
            </div>
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

<script src="{{ 'cabin-waitlist.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Release backlog",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Backlog" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "In development" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Six scents. Three vessels at launch. The formats below are in testing and release in order; leave an address and we will tell you once.</p>" },
    { "type": "header", "content": "Notify module" },
    { "type": "text", "id": "notify_heading", "label": "Heading", "default": "Notify me on release" },
    { "type": "text", "id": "notify_body", "label": "Body", "default": "One message when it ships. Nothing else." },
    { "type": "text", "id": "notify_success", "label": "Success message", "default": "Noted. We will write once, when it is ready." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "release",
      "name": "Upcoming release",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Interior fine-mist spray" },
        { "type": "text", "id": "format", "label": "Format / spec", "default": "50ml · alcohol-free · leather safe" },
        { "type": "text", "id": "eta", "label": "ETA", "default": "Q1 2027" },
        {
          "type": "select",
          "id": "status",
          "label": "Status",
          "options": [
            { "value": "development", "label": "In development" },
            { "value": "testing", "label": "In cabin testing" },
            { "value": "coming-soon", "label": "Coming soon" },
            { "value": "waitlist", "label": "Waitlist open" }
          ],
          "default": "development"
        },
        { "type": "text", "id": "key", "label": "Waitlist key (tag slug)", "info": "Defaults to the handleized title. Customers are tagged notify:<key>." },
        { "type": "richtext", "id": "description", "label": "Description" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "checkbox", "id": "show_notify", "label": "Show notify module", "default": true },
        { "type": "checkbox", "id": "open_by_default", "label": "Expanded by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Release backlog",
      "blocks": [
        { "type": "release", "settings": { "title": "Interior fine-mist spray", "format": "50ml · alcohol-free · leather safe", "eta": "Q1 2027", "status": "testing" } },
        { "type": "release", "settings": { "title": "Heavyweight wax candle", "format": "220g · coconut-rapeseed · single wick", "eta": "Q2 2027", "status": "development" } },
        { "type": "release", "settings": { "title": "Reed diffuser", "format": "100ml · black fibre reeds", "eta": "Q3 2027", "status": "development" } }
      ]
    }
  ]
}
{% endschema %}
