{%- liquid
  assign hero_image = product.featured_image
  if section.settings.image != blank
    assign hero_image = section.settings.image
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .scent-hero {
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  .scent-hero__inner {
    max-width: {{ section.settings.max_width }}px;
    margin-inline: auto;
  }

  .scent-hero__caption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--cabin-space-3);
    margin-top: var(--cabin-space-4);
    text-align: center;
  }

  .scent-hero__caption::before,
  .scent-hero__caption::after {
    content: '';
    width: 1.5rem;
    height: 1px;
    background: var(--cabin-border-strong);
  }
{% endstyle %}

<div class="scent-hero cabin-theme">
  <div class="scent-hero__inner cabin-container">
    {% render 'product-scent-fan', product: product, mode: 'pdp', image: hero_image %}
    {%- if section.settings.caption != blank -%}
      <p class="scent-hero__caption cabin-label">{{ section.settings.caption }}</p>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'scent-modal.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Scent fan hero",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Vessel image override" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Select a note to read its cabin chemistry" },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 320, "max": 900, "step": 10, "unit": "px", "default": 560 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "Scent fan hero" }]
}
{% endschema %}
