{%- comment -%}
  Metafields (namespace cabin)
    season               single_line_text   summer | winter | all-season
    prominence_top       number_integer     0-100
    prominence_heart     number_integer     0-100
    prominence_base      number_integer     0-100
    longevity_min_weeks  number_integer
    longevity_max_weeks  number_integer
    longevity_label      single_line_text   optional override, e.g. "4 to 6 weeks active diffusion"
    sillage              number_integer     1-5
    mood_tags            list.single_line_text
    gender_position      number_integer     0 masculine, 50 unisex, 100 feminine
    scent_family         single_line_text   Woody | Amber | Oriental | Leather | Fresh | Aquatic | Gourmand
{%- endcomment -%}

{%- liquid
  assign mf = product.metafields.cabin
  assign season = mf.season.value | downcase | strip
  assign season_options = 'summer,winter,all-season' | split: ','
  assign p_top = mf.prominence_top.value | default: 0 | plus: 0
  assign p_heart = mf.prominence_heart.value | default: 0 | plus: 0
  assign p_base = mf.prominence_base.value | default: 0 | plus: 0
  assign p_sum = p_top | plus: p_heart | plus: p_base
  if p_sum > 0
    assign w_top = p_top | times: 100.0 | divided_by: p_sum | round
    assign w_heart = p_heart | times: 100.0 | divided_by: p_sum | round
    assign w_base = 100 | minus: w_top | minus: w_heart
  else
    assign w_top = 0
    assign w_heart = 0
    assign w_base = 0
  endif
  assign sillage = mf.sillage.value | default: 0 | plus: 0
  if sillage > 5
    assign sillage = 5
  endif
  assign sillage_labels = 'Subtle,Close,Present,Bold,Commanding' | split: ','
  assign sillage_index = sillage | minus: 1
  assign gender = mf.gender_position.value | default: 50 | plus: 0
  if gender < 0
    assign gender = 0
  elsif gender > 100
    assign gender = 100
  endif
  if gender < 50
    assign gender_lead = 50 | minus: gender | times: 2
    assign gender_rest = 100 | minus: gender_lead
    assign gender_readout = gender_lead | append: '% Masculine / ' | append: gender_rest | append: '% Unisex'
  elsif gender > 50
    assign gender_lead = gender | minus: 50 | times: 2
    assign gender_rest = 100 | minus: gender_lead
    assign gender_readout = gender_lead | append: '% Feminine / ' | append: gender_rest | append: '% Unisex'
  else
    assign gender_readout = '100% Unisex'
  endif
  assign lon_min = mf.longevity_min_weeks.value
  assign lon_max = mf.longevity_max_weeks.value
  assign lon_label = mf.longevity_label.value
  assign moods = mf.mood_tags.value
-%}

{% style %}
  #shopify-section-{{ section.id }} .metrics {
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  .metrics__panel {
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }

  .metrics__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--cabin-space-3);
    margin-bottom: var(--cabin-space-5);
    padding-bottom: var(--cabin-space-4);
    border-bottom: 1px solid var(--cabin-border);
  }

  .metrics__grid {
    display: grid;
    gap: var(--cabin-space-6) var(--cabin-space-7);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: var(--cabin-space-3);
    min-width: 0;
  }

  .metric--wide {
    grid-column: 1 / -1;
  }

  .metric__label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--cabin-space-3);
  }

  .metric__value {
    font-family: var(--cabin-font-ui);
    font-size: var(--cabin-fs-sm);
    font-weight: 500;
    color: var(--cabin-display);
    text-align: right;
  }

  .segmented {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--cabin-border);
    border-radius: var(--cabin-radius-pill);
    background: var(--cabin-canvas);
    width: fit-content;
    max-width: 100%;
  }

  .segmented__item {
    padding: 0.45rem 0.9rem;
    border-radius: var(--cabin-radius-pill);
    font-family: var(--cabin-font-ui);
    font-size: var(--cabin-fs-xs);
    font-weight: 500;
    letter-spacing: var(--cabin-track-label);
    text-transform: uppercase;
    color: var(--cabin-text-muted);
    white-space: nowrap;
  }

  .segmented__item[aria-current="true"] {
    color: var(--cabin-canvas);
    background: var(--cabin-brass);
  }

  .stack {
    display: flex;
    gap: 2px;
    height: 10px;
    border-radius: 4px;
    overflow: visible;
  }

  .stack__seg {
    position: relative;
    height: 100%;
    min-width: 0;
    background: var(--seg-color);
    border-radius: 2px;
    transform-origin: left center;
    transform: scaleX(0);
    animation: stack-grow var(--cabin-dur-slow) var(--cabin-ease-out) forwards;
    animation-delay: var(--seg-delay, 0ms);
  }

  .stack__seg:first-child { border-radius: 4px 2px 2px 4px; }
  .stack__seg:last-child { border-radius: 2px 4px 4px 2px; }

  .stack__seg::after {
    content: attr(data-tip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    transform: translate(-50%, 4px);
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--cabin-border);
    border-radius: var(--cabin-radius-sm);
    background: var(--cabin-elevation-2);
    color: var(--cabin-display);
    font-family: var(--cabin-font-ui);
    font-size: var(--cabin-fs-xs);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--cabin-dur-fast) var(--cabin-ease-out), transform var(--cabin-dur-fast) var(--cabin-ease-out);
    z-index: 2;
  }

  .stack__seg:hover::after,
  .stack__seg:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @keyframes stack-grow {
    to { transform: scaleX(1); }
  }

  .stack-legend {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--cabin-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack-legend__item {
    display: grid;
    grid-template-columns: 8px 1fr;
    column-gap: var(--cabin-space-2);
    align-items: start;
  }

  .stack-legend__swatch {
    width: 8px;
    height: 8px;
    margin-top: 0.3rem;
    border-radius: 2px;
    background: var(--seg-color);
  }

  .stack-legend__name {
    font-family: var(--cabin-font-ui);
    font-size: var(--cabin-fs-xs);
    letter-spacing: var(--cabin-track-label);
    text-transform: uppercase;
    color: var(--cabin-text-muted);
  }

  .stack-legend__pct {
    font-family: var(--cabin-font-ui);
    font-size: var(--cabin-fs-md);
    font-weight: 500;
    color: var(--cabin-display);
  }

  .stack-legend__window {
    font-family: var(--cabin-font-serif);
    font-size: var(--cabin-fs-sm);
    letter-spacing: var(--cabin-track-serif);
    color: var(--cabin-text-muted);
  }

  .hero-figure {
    display: flex;
    align-items: baseline;
    gap: var(--cabin-space-3);
  }

  .hero-figure__value {
    font-family: var(--cabin-font-display);
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--cabin-display);
  }

  .hero-figure__unit {
    font-family: var(--cabin-font-serif);
    font-size: var(--cabin-fs-lg);
    letter-spacing: var(--cabin-track-serif);
    color: var(--cabin-text);
  }

  .meter {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 3px;
    height: 10px;
  }

  .meter__seg {
    border-radius: 2px;
    background: rgba(var(--cabin-brass-rgb), 0.18);
  }

  .meter__seg.is-filled {
    background: var(--cabin-brass);
  }

  .meter__seg:first-child { border-radius: 4px 2px 2px 4px; }
  .meter__seg:last-child { border-radius: 2px 4px 4px 2px; }

  .meter-scale {
    display: flex;
    justify-content: space-between;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cabin-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .spectrum {
    position: relative;
    height: 10px;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--cabin-brass-deep) 0%, var(--cabin-brass) 50%, var(--cabin-brass-light) 100%);
  }

  .spectrum::before,
  .spectrum::after {
    content: '';
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: 1px;
    background: var(--cabin-canvas);
  }

  .spectrum::before { left: calc(100% / 3); }
  .spectrum::after { left: calc(200% / 3); }

  .spectrum__marker {
    position: absolute;
    top: 50%;
    left: var(--pos);
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--cabin-display);
    box-shadow: 0 0 0 2px var(--cabin-elevation), 0 0 0 3px var(--cabin-brass);
    transform: translate(-50%, -50%);
    transition: left var(--cabin-dur-slow) var(--cabin-ease-out);
    z-index: 1;
  }

  .spectrum-scale {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    text-align: center;
  }

  .spectrum-scale span:first-child { text-align: left; }
  .spectrum-scale span:last-child { text-align: right; }

  @media (prefers-reduced-motion: reduce) {
    .stack__seg { animation: none; transform: none; }
    .spectrum__marker { transition: none; }
  }
{% endstyle %}

<div class="metrics cabin-theme">
  <div class="cabin-container">
    <div class="metrics__panel cabin-surface">
      <header class="metrics__head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="cabin-label cabin-label--brass" style="margin:0 0 .4rem">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="cabin-display cabin-display--md" style="margin:0">{{ section.settings.heading }}</h2>
        </div>
        {%- if mf.scent_family.value != blank -%}
          <span class="cabin-pill cabin-pill--brass">{{ mf.scent_family.value }}</span>
        {%- endif -%}
      </header>

      <div class="metrics__grid">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'season' -%}
              <div class="metric" {{ block.shopify_attributes }}>
                <div class="metric__label">
                  <span class="cabin-label">{{ block.settings.label }}</span>
                </div>
                <div class="segmented" role="group" aria-label="{{ block.settings.label | escape }}">
                  {%- for opt in season_options -%}
                    {%- liquid
                      assign is_current = false
                      if season == opt
                        assign is_current = true
                      elsif season == blank and opt == 'all-season'
                        assign is_current = true
                      endif
                    -%}
                    <span class="segmented__item" aria-current="{{ is_current }}">{{ opt | replace: '-', ' ' }}</span>
                  {%- endfor -%}
                </div>
              </div>

            {%- when 'prominence' -%}
              {%- if p_sum > 0 -%}
                <div class="metric metric--wide" {{ block.shopify_attributes }}>
                  <div class="metric__label">
                    <span class="cabin-label">{{ block.settings.label }}</span>
                    <span class="cabin-serif" style="font-size:var(--cabin-fs-sm);color:var(--cabin-text-muted)">{{ block.settings.caption }}</span>
                  </div>
                  <div class="stack" role="img" aria-label="Note prominence: top {{ w_top }} percent, heart {{ w_heart }} percent, base {{ w_base }} percent">
                    <div class="stack__seg" style="--seg-color:var(--cabin-ramp-top);width:{{ w_top }}%;--seg-delay:0ms" data-tip="Top · {{ w_top }}%" tabindex="0"></div>
                    <div class="stack__seg" style="--seg-color:var(--cabin-ramp-heart);width:{{ w_heart }}%;--seg-delay:120ms" data-tip="Heart · {{ w_heart }}%" tabindex="0"></div>
                    <div class="stack__seg" style="--seg-color:var(--cabin-ramp-base);width:{{ w_base }}%;--seg-delay:240ms" data-tip="Base · {{ w_base }}%" tabindex="0"></div>
                  </div>
                  <ul class="stack-legend">
                    <li class="stack-legend__item" style="--seg-color:var(--cabin-ramp-top)">
                      <span class="stack-legend__swatch" aria-hidden="true"></span>
                      <span>
                        <span class="stack-legend__name">Top</span><br>
                        <span class="stack-legend__pct">{{ w_top }}%</span><br>
                        <span class="stack-legend__window">First 10 to 20 min</span>
                      </span>
                    </li>
                    <li class="stack-legend__item" style="--seg-color:var(--cabin-ramp-heart)">
                      <span class="stack-legend__swatch" aria-hidden="true"></span>
                      <span>
                        <span class="stack-legend__name">Heart</span><br>
                        <span class="stack-legend__pct">{{ w_heart }}%</span><br>
                        <span class="stack-legend__window">Hours 1 to 6</span>
                      </span>
                    </li>
                    <li class="stack-legend__item" style="--seg-color:var(--cabin-ramp-base)">
                      <span class="stack-legend__swatch" aria-hidden="true"></span>
                      <span>
                        <span class="stack-legend__name">Base</span><br>
                        <span class="stack-legend__pct">{{ w_base }}%</span><br>
                        <span class="stack-legend__window">The lingering signature</span>
                      </span>
                    </li>
                  </ul>
                </div>
              {%- endif -%}

            {%- when 'longevity' -%}
              {%- if lon_label != blank or lon_min != blank -%}
                <div class="metric" {{ block.shopify_attributes }}>
                  <div class="metric__label">
                    <span class="cabin-label">{{ block.settings.label }}</span>
                  </div>
                  {%- if lon_label != blank -%}
                    <p class="cabin-serif cabin-serif--md" style="margin:0">{{ lon_label }}</p>
                  {%- else -%}
                    <div class="hero-figure">
                      <span class="hero-figure__value">{{ lon_min }}{% if lon_max != blank and lon_max != lon_min %}–{{ lon_max }}{% endif %}</span>
                      <span class="hero-figure__unit">{{ block.settings.unit }}</span>
                    </div>
                  {%- endif -%}
                  {%- if block.settings.footnote != blank -%}
                    <p class="cabin-body" style="margin:0;font-size:var(--cabin-fs-sm);color:var(--cabin-text-muted)">{{ block.settings.footnote }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'sillage' -%}
              {%- if sillage > 0 -%}
                <div class="metric" {{ block.shopify_attributes }}>
                  <div class="metric__label">
                    <span class="cabin-label">{{ block.settings.label }}</span>
                    <span class="metric__value">{{ sillage_labels[sillage_index] }}</span>
                  </div>
                  <div class="meter" role="meter" aria-valuemin="1" aria-valuemax="5" aria-valuenow="{{ sillage }}" aria-valuetext="{{ sillage_labels[sillage_index] }}, {{ sillage }} of 5" aria-label="{{ block.settings.label | escape }}">
                    {%- for i in (1..5) -%}
                      <span class="meter__seg{% if i <= sillage %} is-filled{% endif %}"></span>
                    {%- endfor -%}
                  </div>
                  <div class="meter-scale">
                    <span class="cabin-label" style="font-size:var(--cabin-fs-2xs)">{{ sillage_labels[0] }}</span>
                    <span class="cabin-label" style="font-size:var(--cabin-fs-2xs)">{{ sillage_labels[4] }}</span>
                  </div>
                </div>
              {%- endif -%}

            {%- when 'mood' -%}
              {%- if moods.size > 0 -%}
                <div class="metric" {{ block.shopify_attributes }}>
                  <div class="metric__label">
                    <span class="cabin-label">{{ block.settings.label }}</span>
                  </div>
                  <ul class="tags" aria-label="{{ block.settings.label | escape }}">
                    {%- for mood in moods -%}
                      <li class="cabin-pill">{{ mood }}</li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}

            {%- when 'gender' -%}
              <div class="metric metric--wide" {{ block.shopify_attributes }}>
                <div class="metric__label">
                  <span class="cabin-label">{{ block.settings.label }}</span>
                  <span class="metric__value">{{ gender_readout }}</span>
                </div>
                <div class="spectrum" role="img" aria-label="{{ block.settings.label | escape }}: {{ gender_readout }}">
                  <span class="spectrum__marker" style="--pos:{{ gender }}%"></span>
                </div>
                <div class="spectrum-scale">
                  <span class="cabin-label" style="font-size:var(--cabin-fs-2xs)">Masculine</span>
                  <span class="cabin-label" style="font-size:var(--cabin-fs-2xs)">Unisex</span>
                  <span class="cabin-label" style="font-size:var(--cabin-fs-2xs)">Feminine</span>
                </div>
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Scent metrics panel",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Technical specification" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cabin performance" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "season",
      "name": "Seasonality",
      "limit": 1,
      "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "Seasonality" }]
    },
    {
      "type": "prominence",
      "name": "Note prominence",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Note prominence" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Share of character across the vessel's life" }
      ]
    },
    {
      "type": "longevity",
      "name": "Longevity",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Estimated longevity" },
        { "type": "text", "id": "unit", "label": "Unit", "default": "weeks active diffusion" },
        { "type": "text", "id": "footnote", "label": "Footnote", "default": "Derived from 42-day mass-loss testing, stated conservatively." }
      ]
    },
    {
      "type": "sillage",
      "name": "Sillage / throw",
      "limit": 1,
      "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "Throw strength" }]
    },
    {
      "type": "mood",
      "name": "Mood / tone",
      "limit": 1,
      "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "Olfactory tone" }]
    },
    {
      "type": "gender",
      "name": "Gender spectrum",
      "limit": 1,
      "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "Reads as" }]
    }
  ],
  "presets": [
    {
      "name": "Scent metrics panel",
      "blocks": [
        { "type": "season" },
        { "type": "longevity" },
        { "type": "sillage" },
        { "type": "mood" },
        { "type": "prominence" },
        { "type": "gender" }
      ]
    }
  ]
}
{% endschema %}
