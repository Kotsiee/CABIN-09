{%- comment -%}
  Usage
    {% render 'cabin-notify-form', key: product.handle, title: product.title, heading: 'Notify me on release' %}

  Params
    key       Slug used for the customer tag  notify:<key>   (required)
    title     Human name of the thing being waited on
    heading   Module heading
    body      One-line supporting copy
    success   Success message
    allow_sms Show the SMS channel toggle (default true)

  Posts to Shopify's native customer form. Creates/updates a customer with
  accepts_marketing = true and tags: waitlist, notify:<key>, channel:<email|sms>.
  Build Shopify Email segments on  customer_tags CONTAINS 'notify:<key>'.
{%- endcomment -%}

{%- liquid
  assign notify_key = key | handleize
  assign notify_id = 'notify-' | append: notify_key
  assign notify_heading = heading | default: 'Notify me on release'
  assign notify_body = body | default: 'One message when it ships. Nothing else.'
  assign notify_success = success | default: 'Noted. We will write once, when it is ready.'
  assign notify_tags = 'waitlist, notify:' | append: notify_key
  assign show_sms = true
  if allow_sms == false
    assign show_sms = false
  endif
-%}

{%- unless skip_styles -%}
{% style %}
  .notify {
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--cabin-border);
    border-radius: var(--cabin-radius-md);
    background: var(--cabin-elevation);
  }

  .notify__form {
    display: flex;
    flex-direction: column;
    gap: var(--cabin-space-4);
  }

  .notify__head > * { margin: 0; }
  .notify__head .cabin-label { margin-bottom: var(--cabin-space-2); }
  .notify__body { font-size: var(--cabin-fs-sm); color: var(--cabin-text-muted); margin-top: var(--cabin-space-2); }

  .notify__channels {
    display: flex;
    gap: var(--cabin-space-2);
  }

  .notify__channel input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .notify__channel .cabin-pill { cursor: pointer; }
  .notify__channel input:checked + .cabin-pill { border-color: var(--cabin-brass); color: var(--cabin-display); background: var(--cabin-brass-glow); }
  .notify__channel input:focus-visible + .cabin-pill { outline: 2px solid var(--cabin-brass); outline-offset: 3px; }

  .notify__fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--cabin-space-2);
  }

  @media (min-width: 600px) {
    .notify__fields { grid-template-columns: 1fr auto; }
    .notify__fields .notify__field[data-notify-sms-field]:not([hidden]) { grid-column: 1 / -1; }
  }

  .notify__fine {
    margin: 0;
    font-size: var(--cabin-fs-2xs);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .notify__state {
    margin: 0;
    font-size: var(--cabin-fs-sm);
  }

  .notify__state--error { color: var(--cabin-state-error); }

  .notify__state--success {
    display: flex;
    align-items: center;
    gap: var(--cabin-space-3);
    outline: none;
  }

  .notify__state--success p { margin: 0; }

  .notify__tick {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--cabin-brass);
    border-radius: 50%;
    position: relative;
  }

  .notify__tick::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 46%;
    width: 0.55rem;
    height: 0.3rem;
    border-left: 1px solid var(--cabin-brass);
    border-bottom: 1px solid var(--cabin-brass);
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .notify.is-submitting .cabin-btn { opacity: 0.6; pointer-events: none; }
{% endstyle %}
{%- endunless -%}

{%- unless styles_only -%}
<div
  class="notify"
  data-notify
  data-notify-key="{{ notify_key }}"
  data-notify-title="{{ title | escape }}"
  data-notify-success="{{ notify_success | escape }}"
>
  {%- form 'customer', id: notify_id, class: 'notify__form' -%}
    <input type="hidden" name="contact[tags]" value="{{ notify_tags }}" data-notify-tags>

    {%- if form.posted_successfully? -%}
      <div class="notify__state notify__state--success" role="status" tabindex="-1" data-notify-state="success">
        <span class="notify__tick" aria-hidden="true"></span>
        <p class="cabin-serif cabin-serif--md">{{ notify_success }}</p>
      </div>
    {%- else -%}
      <div class="notify__head">
        <p class="cabin-label cabin-label--brass">{{ notify_heading }}</p>
        {%- if title != blank -%}
          <p class="notify__title cabin-serif cabin-serif--md">{{ title }}</p>
        {%- endif -%}
        <p class="notify__body cabin-body">{{ notify_body }}</p>
      </div>

      {%- if show_sms -%}
        <div class="notify__channels" role="radiogroup" aria-label="Contact channel">
          <label class="notify__channel">
            <input type="radio" name="notify_channel" value="email" checked data-notify-channel>
            <span class="cabin-pill">Email</span>
          </label>
          <label class="notify__channel">
            <input type="radio" name="notify_channel" value="sms" data-notify-channel>
            <span class="cabin-pill">SMS</span>
          </label>
        </div>
      {%- endif -%}

      <div class="notify__fields">
        <div class="notify__field">
          <label class="cabin-visually-hidden" for="{{ notify_id }}-email">Email</label>
          <input
            id="{{ notify_id }}-email"
            class="cabin-input"
            type="email"
            name="contact[email]"
            autocomplete="email"
            inputmode="email"
            placeholder="Email address"
            required
            {% if form.errors %}aria-invalid="true" aria-describedby="{{ notify_id }}-error"{% endif %}
          >
        </div>
        {%- if show_sms -%}
          <div class="notify__field" data-notify-sms-field hidden>
            <label class="cabin-visually-hidden" for="{{ notify_id }}-phone">Mobile number</label>
            <input
              id="{{ notify_id }}-phone"
              class="cabin-input"
              type="tel"
              name="contact[phone]"
              autocomplete="tel"
              inputmode="tel"
              placeholder="+44 7"
              pattern="^\+?[0-9 ]{9,16}$"
              data-notify-phone
            >
          </div>
        {%- endif -%}
        <button type="submit" class="cabin-btn" data-notify-submit>
          <span data-notify-submit-label>Notify me</span>
        </button>
      </div>

      <p class="notify__state notify__state--error" id="{{ notify_id }}-error" role="alert" data-notify-state="error" {% unless form.errors %}hidden{% endunless %}>
        {%- if form.errors -%}
          {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
        {%- endif -%}
      </p>

      <p class="notify__fine cabin-label">By subscribing you agree to receive a single release notice. Unsubscribe in one tap.</p>
    {%- endif -%}
  {%- endform -%}
</div>
{%- endunless -%}
